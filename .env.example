#-----------------------------------------------------------------------
# Application Settings
#-----------------------------------------------------------------------
APP_NAME="Badminton Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://badminton-booking.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

#-----------------------------------------------------------------------
# Logging
#-----------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-----------------------------------------------------------------------
# Database (MySQL via Laragon)
#-----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=badminton_booking
DB_USERNAME=root
DB_PASSWORD=

#-----------------------------------------------------------------------
# Session & Cache
#-----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

#-----------------------------------------------------------------------
# Queue & Broadcasting
#-----------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Broadcasting (untuk real-time notifications nanti)
# Ganti ke "reverb" atau "pusher" saat implementasi real-time
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=ap1

#-----------------------------------------------------------------------
# Redis (opsional, untuk cache/queue yang lebih cepat)
#-----------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-----------------------------------------------------------------------
# Mail (untuk notifikasi booking)
# Gunakan Mailtrap untuk development: https://mailtrap.io
#-----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@badminton.test"
MAIL_FROM_NAME="${APP_NAME}"

#-----------------------------------------------------------------------
# AWS (opsional, untuk file storage)
#-----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#-----------------------------------------------------------------------
# Payment Gateway Simulasi
# Isi credentials saat integrasi payment gateway
#-----------------------------------------------------------------------
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# XENDIT_SECRET_KEY=
# XENDIT_PUBLIC_KEY=
# XENDIT_WEBHOOK_TOKEN=

#-----------------------------------------------------------------------
# Vite
#-----------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
